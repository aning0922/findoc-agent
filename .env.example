# 复制为 .env 并填值(.env 不会进 git)

# 可信 RAG 使用的 OpenAI 兼容同步模型配置
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30

# 当前runtime不读取：仅供旧 hello_llm.py 热身脚本兼容
DEEPSEEK_API_KEY=

# 当前runtime不读取：runtime固定使用 data/runtime/milvus.db，不读取外部Milvus地址
MILVUS_URI=http://localhost:19530
# 当前runtime不读取：pgvector为未来规划，当前不支持切换
# PGVECTOR_DSN=postgresql+psycopg://user:pwd@localhost:5432/findoc

# 当前runtime不读取：可观测接入尚未启用
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# 当前runtime不读取：embedding模型由代码固定为 BAAI/bge-m3；rerank尚未接入
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
